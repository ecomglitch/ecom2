{%- comment -%}
  DrySense image slot. Renders the uploaded image, or a neutral placeholder that
  keeps the final aspect ratio and names the expected asset, so a photo can be
  dropped in later from the theme editor without touching layout.

  Accepts:
  - image: {image} Image from an image_picker setting (optional)
  - number: {string} Image number, e.g. '1'
  - label: {string} Placeholder label, e.g. 'Hero lifestyle'
  - file: {string} Expected filename, e.g. '01-hero.webp'
  - ratio: {string} CSS aspect-ratio, e.g. '4 / 5'
  - sizes: {string} sizes attribute
  - class: {string} Extra classes
  - lazy: {boolean} Lazy-load (default true)
  - alt: {string} Alt text
{%- endcomment -%}
{%- liquid
  assign loading = 'lazy'
  assign priority = 'auto'
  if lazy == false
    assign loading = 'eager'
    assign priority = 'high'
  endif
-%}
<div class="ds-media {{ class }}"{% if ratio %} style="--ds-ratio: {{ ratio }};"{% endif %}>
  {%- if image != blank -%}
    {{
      image
      | image_url: width: 2400
      | image_tag:
        widths: '400, 600, 800, 1000, 1200, 1600, 2000, 2400',
        sizes: sizes,
        loading: loading,
        fetchpriority: priority,
        alt: alt
    }}
  {%- else -%}
    <div class="ds-media__placeholder" role="img" aria-label="Image {{ number }} placeholder">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>
      </svg>
      <span class="ds-media__label">Image {{ number }} — {{ label }}</span>
      {%- if file != blank -%}<span class="ds-media__file">{{ file }}</span>{%- endif -%}
    </div>
  {%- endif -%}
</div>
