{%- comment -%}
  Line icons (Lucide-style, 24px grid, stroke inherits currentColor).

  Accepts:
  - name: {string} thermometer | wind | droplet | home | sliders | timer | shield | lock | headset | check | plus | arrow-right | star
  - class: {string} Extra classes
{%- endcomment -%}
{%- case name -%}
  {%- when 'star' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"/></svg>
  {%- else -%}
    <svg class="ds-icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true">
      {%- case name -%}
        {%- when 'thermometer' -%}<path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/>
        {%- when 'wind' -%}<path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/><path d="M9.6 4.6A2 2 0 1 1 11 8H2"/><path d="M12.6 19.4A2 2 0 1 0 14 16H2"/>
        {%- when 'droplet' -%}<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5S5 13 5 15a7 7 0 0 0 7 7z"/>
        {%- when 'home' -%}<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9v12h14V9"/><path d="M10 21v-6h4v6"/>
        {%- when 'sliders' -%}<path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M2 14h4"/><path d="M10 8h4"/><path d="M18 16h4"/>
        {%- when 'timer' -%}<path d="M10 2h4"/><path d="M12 14l3-3"/><circle cx="12" cy="14" r="8"/>
        {%- when 'shield' -%}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
        {%- when 'lock' -%}<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        {%- when 'headset' -%}<path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/>
        {%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
        {%- when 'plus' -%}<path d="M12 5v14"/><path d="M5 12h14"/>
        {%- when 'arrow-right' -%}<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
      {%- endcase -%}
    </svg>
{%- endcase -%}
