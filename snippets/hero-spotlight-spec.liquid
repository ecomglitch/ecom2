{%- comment -%}
  Renders one spec chip for the hero-spotlight section.

  Accepts:
  - settings: {object} The section settings
  - index: {string} Spec number (1-4)
{%- endcomment -%}
{%- liquid
  assign prefix = 'spec_' | append: index
  assign value_key = prefix | append: '_value'
  assign unit_key = prefix | append: '_unit'
  assign label_key = prefix | append: '_label'
-%}
<li class="hero-spotlight__spec">
  <span class="hero-spotlight__spec-value">
    {{- settings[value_key] | escape -}}
    {%- if settings[unit_key] != blank -%}<span>{{ settings[unit_key] | escape }}</span>{%- endif -%}
  </span>
  {%- if settings[label_key] != blank -%}
    <span class="hero-spotlight__spec-label">{{ settings[label_key] | escape }}</span>
  {%- endif -%}
</li>
