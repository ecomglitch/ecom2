{%- comment -%}
  Media slot for the guide: Shopify video → YouTube/Vimeo → image → placeholder.

  Accepts:
  - settings: {object} Block settings with video, video_url, image
  - label: {string} Placeholder label, e.g. 'Step'
  - number: {number|string} Placeholder number
  - ratio: {string} CSS aspect-ratio, e.g. '4 / 3'
{%- endcomment -%}
<div class="ds-media ds-guide__media" style="--ds-ratio: {{ ratio }};">
  {%- if settings.video != blank -%}
    {{
      settings.video
      | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1200x'
    }}
  {%- elsif settings.video_url != blank -%}
    {{ settings.video_url | external_video_url: rel: 0, modestbranding: 1 | external_video_tag: loading: 'lazy' }}
  {%- elsif settings.image != blank -%}
    {{
      settings.image
      | image_url: width: 1600
      | image_tag: widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy'
    }}
  {%- else -%}
    <div class="ds-media__placeholder" role="img" aria-label="{{ label }} {{ number }} media placeholder">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="15" height="14" rx="2"/><path d="m17 10 5-3v10l-5-3"/></svg>
      <span class="ds-media__label">{{ label }} {{ number }} — image or video</span>
    </div>
  {%- endif -%}
</div>
