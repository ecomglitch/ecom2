{%- comment -%} Short benefit checklist for the product buy box. One benefit per line. {%- endcomment -%}
{%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
<ul class="ds-pdp-checklist" role="list" {{ block.shopify_attributes }}>
  {%- for line in lines -%}
    {%- assign item = line | strip -%}
    {%- if item != blank -%}
      <li>
        <span class="ds-pdp-checklist__icon">{% render 'ds-icon', name: 'check' %}</span>
        {{- item | escape -}}
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

{% schema %}
{
  "name": "DrySense: Checklist",
  "settings": [
    {
      "type": "textarea",
      "id": "items",
      "label": "Benefits",
      "default": "Controlled 48°C warm air\nHelps remove moisture and odor\nDesigned for everyday use",
      "info": "One per line. Keep each to a few words."
    }
  ],
  "presets": [{ "name": "DrySense: Checklist" }]
}
{% endschema %}
