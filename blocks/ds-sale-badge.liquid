{%- comment -%}
  Savings pill computed from the real compare-at price, plus an optional label
  (e.g. the current sale). Renders nothing when the product is not discounted
  and no label is set.
{%- endcomment -%}
{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  assign percent = 0
  if variant.compare_at_price > variant.price
    assign percent = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price
  endif
-%}
{%- if percent > 0 or block.settings.label != blank -%}
  <div class="ds-pdp-sale" {{ block.shopify_attributes }}>
    {%- if percent > 0 -%}
      <span class="ds-pdp-sale__pill">Save {{ percent }}%</span>
      <span class="ds-pdp-sale__amount">
        You save {{ variant.compare_at_price | minus: variant.price | money }}
      </span>
    {%- endif -%}
    {%- if block.settings.label != blank -%}
      <span class="ds-pdp-sale__label">{{ block.settings.label | escape }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "DrySense: Savings badge",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Winter sale",
      "info": "Optional. Clear it when the sale ends."
    }
  ],
  "presets": [{ "name": "DrySense: Savings badge" }]
}
{% endschema %}
