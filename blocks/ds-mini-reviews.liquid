{%- comment -%}
  Compact rotating testimonial for the buy box: photo, quote, name, stars, dots.
  Slides without a quote are skipped (in the editor they show as a hint).
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign count = 0
  for i in (1..3)
    assign k = 'quote_' | append: i
    if s[k] != blank
      assign count = count | plus: 1
    endif
  endfor
-%}

{%- if count > 0 or request.design_mode -%}
  <div class="ds-mini-reviews" data-ds-mini-reviews {{ block.shopify_attributes }}>
    <div class="ds-mini-reviews__track" data-ds-mini-track>
      {%- for i in (1..3) -%}
        {%- liquid
          assign k_img = 'image_' | append: i
          assign k_quote = 'quote_' | append: i
          assign k_name = 'name_' | append: i
        -%}
        {%- if s[k_quote] != blank -%}
          <figure class="ds-mini-reviews__slide">
            <span class="ds-mini-reviews__avatar">
              {%- if s[k_img] != blank -%}
                {{ s[k_img] | image_url: width: 128 | image_tag: width: 56, height: 56, loading: 'lazy', alt: '' }}
              {%- endif -%}
            </span>
            <span class="ds-mini-reviews__body">
              <blockquote>“{{ s[k_quote] | escape }}”</blockquote>
              <figcaption>
                <span>{{ s[k_name] | escape }}</span>
                <span class="ds-mini-reviews__stars" role="img" aria-label="5 out of 5 stars">★★★★★</span>
              </figcaption>
            </span>
          </figure>
        {%- elsif request.design_mode -%}
          <figure class="ds-mini-reviews__slide ds-mini-reviews__slide--empty">
            <span class="ds-mini-reviews__avatar"></span>
            <span class="ds-mini-reviews__body">Testimonial {{ i }}: add a photo, quote and name</span>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="ds-mini-reviews__dots" data-ds-mini-dots aria-hidden="true"></div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "DrySense: Mini reviews",
  "settings": [
    { "type": "paragraph", "content": "Use real customer reviews only. A testimonial without a quote is hidden." },
    { "type": "header", "content": "Testimonial 1" },
    { "type": "image_picker", "id": "image_1", "label": "Photo" },
    { "type": "text", "id": "quote_1", "label": "Quote" },
    { "type": "text", "id": "name_1", "label": "Name" },
    { "type": "header", "content": "Testimonial 2" },
    { "type": "image_picker", "id": "image_2", "label": "Photo" },
    { "type": "text", "id": "quote_2", "label": "Quote" },
    { "type": "text", "id": "name_2", "label": "Name" },
    { "type": "header", "content": "Testimonial 3" },
    { "type": "image_picker", "id": "image_3", "label": "Photo" },
    { "type": "text", "id": "quote_3", "label": "Quote" },
    { "type": "text", "id": "name_3", "label": "Name" }
  ],
  "presets": [{ "name": "DrySense: Mini reviews" }]
}
{% endschema %}
