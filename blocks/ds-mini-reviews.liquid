{%- comment -%}
  Rotating testimonial images for the buy box (e.g. review screenshots).
  Empty slots are skipped; in the editor they show as a hint.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign count = 0
  for i in (1..3)
    assign k = 'image_' | append: i
    if s[k] != blank
      assign count = count | plus: 1
    endif
  endfor
-%}

{%- if count > 0 or request.design_mode -%}
  <div class="ds-mini-reviews" data-ds-mini-reviews {{ block.shopify_attributes }}>
    <div class="ds-mini-reviews__track" data-ds-mini-track>
      {%- for i in (1..3) -%}
        {%- assign k = 'image_' | append: i -%}
        {%- if s[k] != blank -%}
          <div class="ds-mini-reviews__slide">
            {{
              s[k]
              | image_url: width: 1200
              | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 990px) 480px, 92vw', loading: 'lazy', class: 'ds-mini-reviews__image'
            }}
          </div>
        {%- elsif request.design_mode -%}
          <div class="ds-mini-reviews__slide ds-mini-reviews__slide--empty">Testimonial image {{ i }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="ds-mini-reviews__dots" data-ds-mini-dots aria-hidden="true"></div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "DrySense: Mini reviews",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Testimonial image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Testimonial image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Testimonial image 3" }
  ],
  "presets": [{ "name": "DrySense: Mini reviews" }]
}
{% endschema %}
