{%- comment -%}
  DrySense header: logo · navigation · account + cart.
  Navigation links are blocks (label + link, or a product), so Shop / Guide
  etc. are managed here instead of the theme menu. Account and cart reuse the
  theme's header-actions component, so the cart count and cart drawer keep
  working. Sticky, with a hairline that appears on scroll.
{%- endcomment -%}
{%- liquid
  assign logo = section.settings.logo | default: settings.logo
  assign current = request.path
-%}

<div class="ds-header" data-ds-header style="--ds-logo-h: {{ section.settings.logo_height }}px;">
  <div class="ds-header__inner">
    <button
      type="button"
      class="ds-header__burger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="DsHeaderMenu"
      data-ds-menu-toggle
    >
      <span></span><span></span>
    </button>

    <a class="ds-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if logo != blank -%}
        {{
          logo
          | image_url: width: 480
          | image_tag: widths: '160, 240, 320, 480', sizes: '280px', alt: shop.name, loading: 'eager'
        }}
      {%- else -%}
        <span class="ds-header__wordmark">{{ shop.name | upcase | escape }}</span>
      {%- endif -%}
    </a>

    <nav class="ds-header__nav" id="DsHeaderMenu" aria-label="Main">
      <ul class="ds-header__links" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign url = block.settings.link
            if block.settings.product != blank
              assign url = block.settings.product.url
            endif
            assign active = false
            if url == current
              assign active = true
            endif
          -%}
          {%- if block.settings.label != blank and url != blank -%}
            <li {{ block.shopify_attributes }}>
              <a
                class="ds-header__link{% if block.settings.highlight %} ds-header__link--highlight{% endif %}"
                href="{{ url }}"
                {% if active %}
                  aria-current="page"
                {% endif %}
              >
                {{- block.settings.label | escape -}}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
        {%- if shop.customer_accounts_enabled -%}
          <li class="ds-header__mobile-only">
            <a class="ds-header__link ds-header__link--account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
              <svg class="ds-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
              {%- if customer -%}My account{%- else -%}Sign in{%- endif -%}
            </a>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    <div class="ds-header__actions">
      {% render 'header-actions', section: section, display_style: 'icon' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "DrySense: Header",
  "tag": "div",
  "class": "ds-header-section",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Link" },
        { "type": "product", "id": "product", "label": "Product", "info": "Optional. Overrides the link below." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight (orange dot)", "default": false }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Defaults to the logo in Theme settings"
    },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 40, "info": "Phones use about 80% of this" }
  ],
  "presets": [{ "name": "DrySense: Header" }]
}
{% endschema %}
