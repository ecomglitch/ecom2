{%- comment -%}
  Guide page: intro, numbered steps (image / video + text, alternating),
  full-width video, tips list and a closing call to action.
  Each media slot accepts a Shopify video, a YouTube/Vimeo link, or an image.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign step_no = 0
  assign cta_url = '/#shop'
  if s.cta_product != blank
    assign cta_url = s.cta_product.url
  endif
-%}

<section class="ds ds-guide" aria-labelledby="DsGuideHeading-{{ section.id }}">
  <div class="ds__container">
    <header class="ds-head ds-head--center ds-guide__head">
      {%- if s.eyebrow != blank -%}<p class="ds-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h1 id="DsGuideHeading-{{ section.id }}" class="ds-h1">{{ s.heading | escape }}</h1>
      {%- if s.text != blank -%}<p class="ds-lead">{{ s.text | escape }}</p>{%- endif -%}
    </header>

    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      {%- case block.type -%}
        {%- when 'step' -%}
          {%- assign step_no = step_no | plus: 1 -%}
          {%- assign odd = step_no | modulo: 2 -%}
          <article class="ds-guide__step{% if odd == 0 %} ds-guide__step--reverse{% endif %}" {{ block.shopify_attributes }}>
            {% render 'ds-guide-media', settings: b, label: 'Step', number: step_no, ratio: '4 / 3' %}
            <div class="ds-guide__copy">
              <span class="ds-guide__num">{{ step_no | prepend: '0' | slice: -2, 2 }}</span>
              <h2 class="ds-h2 ds-guide__title">{{ b.title | escape }}</h2>
              <div class="ds-body ds-guide__text">{{ b.text }}</div>
            </div>
          </article>

        {%- when 'video' -%}
          <figure class="ds-guide__video" {{ block.shopify_attributes }}>
            {% render 'ds-guide-media', settings: b, label: 'Video', number: '', ratio: '16 / 9' %}
            {%- if b.caption != blank -%}
              <figcaption class="ds-guide__caption">{{ b.caption | escape }}</figcaption>
            {%- endif -%}
          </figure>

        {%- when 'tips' -%}
          {%- assign tips = b.tips | newline_to_br | split: '<br />' -%}
          <div class="ds-guide__tips" {{ block.shopify_attributes }}>
            <h2 class="ds-h2">{{ b.title | escape }}</h2>
            <ul class="ds-guide__tip-list" role="list">
              {%- for tip in tips -%}
                {%- assign t = tip | strip -%}
                {%- if t != blank -%}
                  <li>
                    <span class="ds-guide__tip-icon">{% render 'ds-icon', name: 'check' %}</span>
                    {{- t | escape -}}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
      {%- endcase -%}
    {%- endfor -%}

    {%- if s.cta_label != blank -%}
      <div class="ds-guide__cta">
        <h2 class="ds-h2">{{ s.cta_heading | escape }}</h2>
        <a class="ds-btn ds-btn--primary" href="{{ cta_url }}">{{ s.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DrySense: Guide",
  "tag": "div",
  "max_blocks": 16,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (Shopify)" },
        { "type": "video_url", "id": "video_url", "label": "or YouTube / Vimeo link", "accept": ["youtube", "vimeo"] },
        { "type": "image_picker", "id": "image", "label": "or Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this step.</p>" }
      ]
    },
    {
      "type": "video",
      "name": "Full-width video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (Shopify)" },
        { "type": "video_url", "id": "video_url", "label": "or YouTube / Vimeo link", "accept": ["youtube", "vimeo"] },
        { "type": "image_picker", "id": "image", "label": "or Image" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    },
    {
      "type": "tips",
      "name": "Tips",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Tips for the best results" },
        { "type": "textarea", "id": "tips", "label": "Tips", "info": "One per line" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to Use DrySense" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Fresh, dry shoes in a few simple steps." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Ready for dry, fresh shoes?" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop DrySense Pro" },
    { "type": "product", "id": "cta_product", "label": "Button product" }
  ],
  "presets": [{ "name": "DrySense: Guide" }]
}
{% endschema %}
