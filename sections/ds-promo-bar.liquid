{%- comment -%}
  Top bar: language switcher · sale offer with a real countdown.
  - The countdown runs to the end date/time set here (store time zone). When the
    sale ends, the offer + timer disappear (server-side and live); the language
    switcher stays.
  - The language switcher is design-only for now (no translation yet).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign show_offer = true
  assign end_iso = ''

  if s.end_date != blank
    assign end_time = s.end_time | default: '23:59'
    assign tz = 'now' | date: '%z'
    assign tz_hours = tz | slice: 0, 3
    assign tz_minutes = tz | slice: 3, 2
    assign end_iso = s.end_date | append: 'T' | append: end_time | append: ':00' | append: tz_hours | append: ':' | append: tz_minutes
    assign now_key = 'now' | date: '%Y%m%d%H%M' | plus: 0
    assign end_key = s.end_date | remove: '-' | append: end_time | remove: ':' | plus: 0
    if now_key >= end_key
      assign show_offer = false
    endif
  endif

  assign shop_url = '/#shop'
  if s.shop_product != blank
    assign shop_url = s.shop_product.url
  endif

  assign lang_lines = s.languages | newline_to_br | split: '<br />'
  assign first_line = lang_lines.first | strip | split: '|'
  assign current_code = first_line.first | strip
-%}

{%- if s.enabled -%}
  <div class="ds-promo">
    <div class="ds-promo__inner">
      {%- comment -%} Language switcher (design only) {%- endcomment -%}
      <div class="ds-promo__side ds-promo__side--start">
        {%- if s.show_languages and current_code != blank -%}
          <details class="ds-lang" data-ds-lang>
            <summary class="ds-lang__toggle" aria-label="Language: {{ first_line.last | strip | escape }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18"/></svg>
              <span>{{ current_code | upcase | escape }}</span>
              <svg class="ds-lang__caret" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <ul class="ds-lang__menu" role="list">
              {%- for line in lang_lines -%}
                {%- assign parts = line | strip | split: '|' -%}
                {%- if parts.size > 0 -%}
                  {%- assign code = parts.first | strip -%}
                  <li>
                    <button
                      type="button"
                      class="ds-lang__option"
                      data-ds-lang-code="{{ code | upcase | escape }}"
                      {% if forloop.first %}
                        aria-current="true"
                      {% endif %}
                    >
                      <span class="ds-lang__code">{{ code | upcase | escape }}</span>
                      <span>{{ parts.last | strip | escape }}</span>
                    </button>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </details>
        {%- endif -%}
      </div>

      {%- if show_offer -%}
        <a
          class="ds-promo__center"
          href="{{ s.link | default: shop_url }}"
          {% if end_iso != blank %}
            data-ds-countdown="{{ end_iso }}"
          {% endif %}
        >
          <span class="ds-promo__offer">
            <span class="ds-promo__dot" aria-hidden="true"></span>
            <span class="ds-promo__label">{{ s.label | escape }}</span>
            <span class="ds-promo__sep" aria-hidden="true"></span>
            <span class="ds-promo__deal">{{ s.offer | escape }}</span>
            {%- if s.extra != blank -%}
              <span class="ds-promo__extra">{{ s.extra | escape }}</span>
            {%- endif -%}
          </span>

          {%- if end_iso != blank -%}
            <span class="ds-promo__timer" role="timer" aria-label="{{ s.timer_label | escape }} {{ s.end_date }} {{ s.end_time }}">
              <span class="ds-promo__timer-label">{{ s.timer_label | escape }}</span>
              <span class="ds-promo__units" aria-hidden="true">
                <span class="ds-promo__unit"><b data-ds-cd="d">00</b><i>d</i></span>
                <span class="ds-promo__unit"><b data-ds-cd="h">00</b><i>h</i></span>
                <span class="ds-promo__unit"><b data-ds-cd="m">00</b><i>m</i></span>
                <span class="ds-promo__unit"><b data-ds-cd="s">00</b><i>s</i></span>
              </span>
            </span>
          {%- endif -%}
        </a>
      {%- endif -%}

      <div class="ds-promo__side ds-promo__side--end">
        {%- comment -%} Country / currency selector (Shopify Markets) {%- endcomment -%}
        {%- if s.show_currency and localization.available_countries.size > 1 -%}
          {%- form 'localization', id: 'DsCurrencyForm', class: 'ds-currency' -%}
            <details class="ds-lang ds-lang--end" data-ds-lang>
              <summary class="ds-lang__toggle" aria-label="Country / currency: {{ localization.country.name | escape }} ({{ localization.country.currency.iso_code }})">
                <span>{{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}</span>
                <svg class="ds-lang__caret" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <ul class="ds-lang__menu ds-lang__menu--scroll" role="list">
                {%- for c in localization.available_countries -%}
                  <li>
                    <button
                      type="submit"
                      name="country_code"
                      value="{{ c.iso_code }}"
                      class="ds-lang__option"
                      {% if c.iso_code == localization.country.iso_code %}
                        aria-current="true"
                      {% endif %}
                    >
                      <span class="ds-lang__code">{{ c.currency.iso_code }}</span>
                      <span>{{ c.name | escape }}</span>
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
            </details>
            <input type="hidden" name="return_to" value="{{ request.path }}">
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "DrySense: Promo bar",
  "tag": "div",
  "class": "ds-promo-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show top bar", "default": true },
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "label", "label": "Label", "default": "Winter Sale" },
    { "type": "text", "id": "offer", "label": "Offer (highlighted)", "default": "35% OFF" },
    { "type": "text", "id": "extra", "label": "Extra", "default": "+ Free shipping", "info": "Hidden on phones" },
    { "type": "url", "id": "link", "label": "Offer link", "info": "Defaults to the offer product below" },
    { "type": "header", "content": "Countdown" },
    {
      "type": "text",
      "id": "end_date",
      "label": "Sale ends on (YYYY-MM-DD)",
      "info": "Use the real end date. The offer and timer hide themselves when the sale ends. Leave blank for no timer."
    },
    { "type": "text", "id": "end_time", "label": "Ends at (HH:MM, store time)", "default": "23:59" },
    { "type": "text", "id": "timer_label", "label": "Timer label", "default": "Ends in" },
    { "type": "product", "id": "shop_product", "label": "Offer product", "info": "Where the offer links to when no link is set, e.g. DrySense Pro" },
    { "type": "header", "content": "Currency" },
    { "type": "checkbox", "id": "show_currency", "label": "Show country / currency selector", "default": true, "info": "Appears when more than one country is active in Settings → Markets" },
    { "type": "header", "content": "Language switcher" },
    { "type": "checkbox", "id": "show_languages", "label": "Show language switcher", "default": true },
    {
      "type": "textarea",
      "id": "languages",
      "label": "Languages",
      "default": "EN|English\nSQ|Shqip\nDE|Deutsch\nIT|Italiano\nFR|Français",
      "info": "One per line as CODE|Name. The first one is shown as selected. Design only for now: no translation yet."
    }
  ],
  "presets": [{ "name": "DrySense: Promo bar" }]
}
{% endschema %}
