{%- comment -%}
  Animated promo strip. Scrolls left → right, pauses on hover, and stops for
  shoppers who prefer reduced motion. Hides itself after the end date so an
  expired offer is never shown.
{%- endcomment -%}
{%- liquid
  assign show = section.settings.enabled
  if section.settings.end_date != blank
    assign today = 'now' | date: '%Y%m%d' | plus: 0
    assign ends = section.settings.end_date | remove: '-' | plus: 0
    if ends > 0 and today > ends
      assign show = false
    endif
  endif
-%}

{%- if show -%}
  {%- capture item -%}
    <span class="ds-promo__item">
      <svg class="ds-promo__flake" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2v20M4.9 4.9l14.2 14.2M2 12h20M4.9 19.1 19.1 4.9M9 3.5l3 2.5 3-2.5M9 20.5l3-2.5 3 2.5M3.5 9l2.5 3-2.5 3M20.5 9 18 12l2.5 3"/>
      </svg>
      <span class="ds-promo__title">{{ section.settings.title | escape }}</span>
      <span class="ds-promo__deal">{{ section.settings.deal | escape }}</span>
      {%- if section.settings.extra != blank -%}
        <span class="ds-promo__extra">{{ section.settings.extra | escape }}</span>
      {%- endif -%}
    </span>
  {%- endcapture -%}

  <div class="ds-promo" style="--ds-promo-speed: {{ section.settings.speed }}s;">
    <a
      class="ds-promo__link"
      href="{{ section.settings.link | default: '/#shop' }}"
      aria-label="{{ section.settings.title | escape }} {{ section.settings.deal | escape }} {{ section.settings.extra | escape }}"
    >
      <span class="ds-promo__track" aria-hidden="true">
        {%- for i in (1..2) -%}
          <span class="ds-promo__group">
            {%- for j in (1..6) -%}{{ item }}{%- endfor -%}
          </span>
        {%- endfor -%}
      </span>
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "DrySense: Promo bar",
  "tag": "div",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show promo bar", "default": true },
    {
      "type": "text",
      "id": "end_date",
      "label": "Sale ends (YYYY-MM-DD)",
      "info": "Optional. The bar hides itself automatically after this date."
    },
    { "type": "text", "id": "title", "label": "Title", "default": "Winter Sale" },
    { "type": "text", "id": "deal", "label": "Deal (highlighted)", "default": "35% OFF" },
    { "type": "text", "id": "extra", "label": "Extra", "default": "+ Free shipping" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the product section on the homepage" },
    { "type": "range", "id": "speed", "label": "Scroll duration", "min": 10, "max": 60, "step": 2, "unit": "s", "default": 28, "info": "Lower is faster" }
  ],
  "presets": [{ "name": "DrySense: Promo bar" }]
}
{% endschema %}
