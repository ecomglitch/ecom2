{%- comment -%}
  Reviews. The cards are written by the merchant, so they stay hidden from
  shoppers until "These are real customer reviews" is ticked. In the theme
  editor they are always previewed, with a reminder. A reviews app block can
  be added instead (or as well) and will render below the cards.
{%- endcomment -%}
{%- liquid
  assign show_cards = section.settings.reviews_are_real
  if request.design_mode
    assign show_cards = true
  endif
  assign card_count = 0
  assign app_count = 0
  for block in section.blocks
    if block.type == 'review'
      assign card_count = card_count | plus: 1
    else
      assign app_count = app_count | plus: 1
    endif
  endfor

  assign show_section = false
  if app_count > 0
    assign show_section = true
  elsif show_cards and card_count > 0
    assign show_section = true
  endif
-%}

{%- if show_section -%}
  <section
    id="reviews"
    class="ds ds-anchor ds-reviews"
    aria-labelledby="DsReviewsHeading-{{ section.id }}"
  >
    <div class="ds__container">
      <header class="ds-head" data-ds-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="DsReviewsHeading-{{ section.id }}" class="ds-h2">{{ section.settings.heading | escape }}</h2>
      </header>

      {%- if show_cards and card_count > 0 -%}
        <div class="ds-reviews__grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <figure class="ds-review" data-ds-reveal style="--ds-delay: {{ forloop.index0 | times: 100 }}ms;" {{ block.shopify_attributes }}>
                <div class="ds-review__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {%- for i in (1..block.settings.rating) -%}
                    {% render 'ds-icon', name: 'star' %}
                  {%- endfor -%}
                </div>
                <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
                <figcaption>— {{ block.settings.author | escape }}</figcaption>
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="ds-reviews__app">{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}

      {%- if request.design_mode and section.settings.reviews_are_real == false -%}
        <p class="ds-reviews__note">
          Editor preview only: these sample reviews are hidden from shoppers. Replace them with real customer
          feedback, then tick “These are real customer reviews” — or add your reviews app block.
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "DrySense: Reviews",
  "tag": "div",
  "max_blocks": 6,
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Name" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Experiences. Better Mornings." },
    {
      "type": "checkbox",
      "id": "reviews_are_real",
      "label": "These are real customer reviews",
      "default": false,
      "info": "Leave off while using sample text. Review cards are only shown to shoppers when this is on."
    }
  ],
  "presets": [{ "name": "DrySense: Reviews" }]
}
{% endschema %}
