{%- comment -%}
  Side-by-side chart: short values, icons, Pro column highlighted.
  A cell value of "yes" renders a check, "no" renders a dash.
{%- endcomment -%}
{%- liquid
  assign classic = section.settings.classic_product
  assign pro = section.settings.pro_product
-%}

<section class="ds ds--alt ds-compare" aria-labelledby="DsCompareHeading-{{ section.id }}">
  <div class="ds__container">
    <header class="ds-head ds-head--center" data-ds-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="DsCompareHeading-{{ section.id }}" class="ds-h2">{{ section.settings.heading | escape }}</h2>
      <p class="ds-lead">{{ section.settings.text | escape }}</p>
    </header>

    {%- if section.settings.show_image -%}
      {% render 'ds-media',
        image: section.settings.image,
        number: '4',
        label: 'Classic vs Pro comparison',
        file: '04-comparison.webp',
        ratio: '21 / 9',
        class: 'ds-compare__media',
        sizes: '(min-width: 1200px) 1200px, 100vw',
        alt: 'DrySense Classic and DrySense Pro side by side'
      %}
    {%- endif -%}

    <div class="ds-vs" role="table" aria-label="DrySense Classic and Pro compared" data-ds-reveal>
      <div class="ds-vs__row ds-vs__row--head" role="row">
        <span class="ds-vs__label" role="columnheader"><span class="visually-hidden">Feature</span></span>
        <div class="ds-vs__cell" role="columnheader">
          <span class="ds-vs__name">Classic</span>
          <span class="ds-vs__price">
            {%- if classic != blank -%}{{ classic.price | money }}{%- else -%}{{ section.settings.classic_price }}{%- endif -%}
          </span>
        </div>
        <div class="ds-vs__cell ds-vs__cell--pro" role="columnheader">
          {%- if section.settings.pro_badge != blank -%}
            <span class="ds-vs__badge">{{ section.settings.pro_badge | escape }}</span>
          {%- endif -%}
          <span class="ds-vs__name">Pro</span>
          <span class="ds-vs__price">
            {%- if pro != blank -%}{{ pro.price | money }}{%- else -%}{{ section.settings.pro_price }}{%- endif -%}
          </span>
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div class="ds-vs__row" role="row" {{ block.shopify_attributes }}>
          <span class="ds-vs__label" role="rowheader">
            {% render 'ds-icon', name: block.settings.icon %}
            {{- block.settings.label | escape -}}
          </span>
          {%- assign values = block.settings.classic | append: '|||' | append: block.settings.pro | split: '|||' -%}
          {%- for value in values -%}
            {%- assign v = value | strip | downcase -%}
            <span class="ds-vs__cell{% if forloop.last %} ds-vs__cell--pro{% endif %}" role="cell">
              {%- if v == 'yes' -%}
                <span class="ds-vs__yes">{% render 'ds-icon', name: 'check' %}<span class="visually-hidden">Yes</span></span>
              {%- elsif v == 'no' -%}
                <span class="ds-vs__no" aria-label="No">—</span>
              {%- else -%}
                {{ value | escape }}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      {%- endfor -%}

      <div class="ds-vs__row ds-vs__row--foot" role="row">
        <span class="ds-vs__label" role="cell"></span>
        <span class="ds-vs__cell" role="cell">
          <a class="ds-btn ds-btn--ghost ds-btn--block" href="{% if classic != blank %}{{ classic.url }}{% else %}#shop{% endif %}">Shop Classic</a>
        </span>
        <span class="ds-vs__cell ds-vs__cell--pro" role="cell">
          <a class="ds-btn ds-btn--primary ds-btn--block" href="{% if pro != blank %}{{ pro.url }}{% else %}#shop{% endif %}">Shop Pro</a>
        </span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DrySense: Comparison",
  "tag": "div",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "target", "label": "Target" },
            { "value": "expand", "label": "Arms" },
            { "value": "monitor", "label": "Display" },
            { "value": "thermometer", "label": "Thermometer" },
            { "value": "palette", "label": "Finish" },
            { "value": "wind", "label": "Airflow" },
            { "value": "timer", "label": "Timer" }
          ],
          "default": "target"
        },
        { "type": "text", "id": "label", "label": "Feature", "default": "Feature" },
        { "type": "text", "id": "classic", "label": "Classic", "default": "yes", "info": "Keep it to 1–4 words. Type yes for ✓ or no for —." },
        { "type": "text", "id": "pro", "label": "Pro", "default": "yes" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two Models. One Fresh Start." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Find the DrySense that fits your everyday routine." },
    { "type": "text", "id": "pro_badge", "label": "Pro badge", "default": "Recommended" },
    { "type": "checkbox", "id": "show_image", "label": "Show comparison image", "default": false },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image 4 — Classic vs Pro",
      "info": "04-comparison.webp · Wide 21:9. Both models together in one studio shot."
    },
    { "type": "header", "content": "Prices" },
    { "type": "product", "id": "classic_product", "label": "Classic product" },
    { "type": "product", "id": "pro_product", "label": "Pro product" },
    { "type": "text", "id": "classic_price", "label": "Classic fallback price", "default": "$49.99" },
    { "type": "text", "id": "pro_price", "label": "Pro fallback price", "default": "$54.99" }
  ],
  "presets": [{ "name": "DrySense: Comparison" }]
}
{% endschema %}
