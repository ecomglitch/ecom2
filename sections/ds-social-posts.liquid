{%- comment -%} Three testimonial screenshots on a wavy orange band. {%- endcomment -%}
<section class="ds-social" aria-labelledby="DsSocialHeading-{{ section.id }}">
  <svg class="ds-social__wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 22 C 360 4, 720 4, 1080 14 S 1440 28, 1440 28 V60 H0Z" fill="var(--ds-band-soft)"/>
    <path d="M0 34 C 400 12, 760 10, 1100 22 S 1440 40, 1440 40 V60 H0Z" fill="var(--ds-band)"/>
  </svg>

  <div class="ds-social__band">
    <div class="ds__container">
      <h2 id="DsSocialHeading-{{ section.id }}" class="ds-h2 ds-social__heading">{{ section.settings.heading | escape }}</h2>

      <ul class="ds-social__track" role="list">
        {%- for i in (1..3) -%}
          {%- assign key = 'image_' | append: i -%}
          {%- assign image = section.settings[key] -%}
          <li class="ds-social__item">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 960
                | image_tag: widths: '320, 480, 640, 960', sizes: '(min-width: 900px) 320px, 82vw', loading: 'lazy', class: 'ds-social__image'
              }}
            {%- elsif request.design_mode -%}
              <div class="ds-social__placeholder">Testimonial {{ i }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <svg class="ds-social__wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0 H1440 V26 C 1080 40, 720 46, 360 38 S 0 30, 0 30Z" fill="var(--ds-band-soft)"/>
    <path d="M0 0 H1440 V16 C 1080 30, 720 34, 360 28 S 0 20, 0 20Z" fill="var(--ds-band)"/>
  </svg>
</section>

{% schema %}
{
  "name": "DrySense: Social posts",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What People Are Saying" },
    { "type": "image_picker", "id": "image_1", "label": "Testimonial 1" },
    { "type": "image_picker", "id": "image_2", "label": "Testimonial 2" },
    { "type": "image_picker", "id": "image_3", "label": "Testimonial 3" }
  ],
  "presets": [{ "name": "DrySense: Social posts" }]
}
{% endschema %}
