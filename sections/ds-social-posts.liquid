{%- comment -%}
  Social-post style testimonials on a wavy colour band. All content is entered
  by the merchant; engagement counts and timestamps are optional and should
  only be filled in from real posts.
{%- endcomment -%}
{%- liquid
  assign band = section.settings.band_color
  assign band_soft = section.settings.band_color | color_modify: 'alpha', 0.35
-%}

<section
  class="ds-social"
  style="--ds-band: {{ band }}; --ds-band-soft: {{ band_soft }}; --ds-band-text: {{ section.settings.heading_color }};"
  aria-labelledby="DsSocialHeading-{{ section.id }}"
>
  <svg class="ds-social__wave ds-social__wave--top" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 22 C 360 4, 720 4, 1080 14 S 1440 28, 1440 28 V60 H0Z" fill="var(--ds-band-soft)"/>
    <path d="M0 34 C 400 12, 760 10, 1100 22 S 1440 40, 1440 40 V60 H0Z" fill="var(--ds-band)"/>
  </svg>

  <div class="ds-social__band">
    <div class="ds__container">
      <h2 id="DsSocialHeading-{{ section.id }}" class="ds-h2 ds-social__heading">{{ section.settings.heading | escape }}</h2>

      <ul class="ds-social__track" role="list">
        {%- for block in section.blocks -%}
          {%- assign s = block.settings -%}
          {%- comment -%} Unedited sample posts are only shown in the theme editor {%- endcomment -%}
          {%- if s.text == 'Paste the real customer comment here.' and request.design_mode == false -%}{%- continue -%}{%- endif -%}
          <li class="ds-social__item" {{ block.shopify_attributes }}>
            <article class="ds-post">
              <header class="ds-post__head">
                <span class="ds-post__avatar">
                  {%- if s.avatar != blank -%}
                    {{ s.avatar | image_url: width: 96 | image_tag: width: 40, height: 40, loading: 'lazy', alt: '' }}
                  {%- else -%}
                    {{ s.name | slice: 0 | upcase | default: '?' }}
                  {%- endif -%}
                </span>
                <span class="ds-post__meta">
                  <span class="ds-post__name">{{ s.name | escape }}</span>
                  {%- if s.time != blank -%}<span class="ds-post__time">{{ s.time | escape }}</span>{%- endif -%}
                </span>
                <span class="ds-post__more" aria-hidden="true">•••</span>
              </header>

              <p class="ds-post__text">{{ s.text | escape }}</p>

              {%- if s.image != blank -%}
                <div class="ds-post__image">
                  {{ s.image | image_url: width: 700 | image_tag: widths: '350, 500, 700', sizes: '320px', loading: 'lazy' }}
                </div>
              {%- endif -%}

              {%- if s.reactions != blank or s.comments != blank -%}
                <div class="ds-post__stats">
                  {%- if s.reactions != blank -%}
                    <span class="ds-post__reactions">
                      <span class="ds-post__emoji" aria-hidden="true">
                        <i style="background:#1877f2">👍</i><i style="background:#f33e58">❤</i><i style="background:#f7b125">😆</i>
                      </span>
                      {{ s.reactions | escape }}
                    </span>
                  {%- endif -%}
                  {%- if s.comments != blank -%}<span>{{ s.comments | escape }} comments</span>{%- endif -%}
                </div>
              {%- endif -%}

              <div class="ds-post__actions" aria-hidden="true">
                <span>
                  <svg viewBox="0 0 24 24"><path d="M7 10v12"/><path d="M15 5.9 14 10h5.8a2 2 0 0 1 1.9 2.6l-2.3 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.8a2 2 0 0 0 1.8-1.1L12 2a3.1 3.1 0 0 1 3 3.9z"/></svg>
                  Like
                </span>
                <span>
                  <svg viewBox="0 0 24 24"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg>
                  Comment
                </span>
                <span>
                  <svg viewBox="0 0 24 24"><path d="m15 14 5-5-5-5"/><path d="M4 20v-7a4 4 0 0 1 4-4h12"/></svg>
                  Share
                </span>
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <svg class="ds-social__wave ds-social__wave--bottom" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0 H1440 V26 C 1080 40, 720 46, 360 38 S 0 30, 0 30Z" fill="var(--ds-band-soft)"/>
    <path d="M0 0 H1440 V16 C 1080 30, 720 34, 360 28 S 0 20, 0 20Z" fill="var(--ds-band)"/>
  </svg>
</section>

{% schema %}
{
  "name": "DrySense: Social posts",
  "tag": "div",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Profile photo" },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
        { "type": "textarea", "id": "text", "label": "Post text", "default": "Paste the real customer comment here." },
        { "type": "image_picker", "id": "image", "label": "Post photo (optional)" },
        { "type": "header", "content": "Optional details" },
        { "type": "paragraph", "content": "Only fill these in from the real post. Leave blank to hide." },
        { "type": "text", "id": "time", "label": "Time / date", "info": "e.g. 2h ago or Nov 12" },
        { "type": "text", "id": "reactions", "label": "Reactions", "info": "e.g. 128" },
        { "type": "text", "id": "comments", "label": "Comments", "info": "e.g. 14" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What People Are Saying" },
    { "type": "color", "id": "band_color", "label": "Band color", "default": "#E97835" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" }
  ],
  "presets": [
    {
      "name": "DrySense: Social posts",
      "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }]
    }
  ]
}
{% endschema %}
