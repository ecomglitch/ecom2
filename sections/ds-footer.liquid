{%- liquid
  assign classic = section.settings.classic_product
  assign pro = section.settings.pro_product
-%}

<footer class="ds ds-footer" aria-label="Footer">
  <div class="ds__container">
    <div class="ds-footer__top">
      <div>
        <div class="ds-footer__brand">{{ section.settings.brand | escape }}</div>
        <p class="ds-footer__tagline">{{ section.settings.tagline | escape }}</p>
        <p class="ds-footer__desc">{{ section.settings.description | escape }}</p>
        <div class="ds-footer__social">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2zM12 0C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.2 4.4 2.6 6.8 7 7 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c4.4-.2 6.8-2.6 7-7 .1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.2-4.4-2.6-6.8-7-7C15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok != blank -%}
            <a href="{{ section.settings.tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.6 6.7a4.8 4.8 0 0 1-3.8-4.2V2h-3.4v13.7a2.9 2.9 0 1 1-2-2.8V9.4a6.3 6.3 0 1 0 5.4 6.3V8.7a8.2 8.2 0 0 0 4.8 1.5V6.8l-1-.1z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.facebook != blank -%}
            <a href="{{ section.settings.facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4h-3V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <nav aria-label="Shop">
        <p class="ds-footer__heading">Shop</p>
        <ul role="list">
          <li><a href="{% if classic != blank %}{{ classic.url }}{% else %}{{ routes.root_url }}#shop{% endif %}">Shop Classic</a></li>
          <li><a href="{% if pro != blank %}{{ pro.url }}{% else %}{{ routes.root_url }}#shop{% endif %}">Shop Pro</a></li>
          <li><a href="{{ routes.root_url }}#how-it-works">How It Works</a></li>
          <li><a href="{{ routes.root_url }}#reviews">Reviews</a></li>
          <li><a href="{{ routes.root_url }}#faq">FAQ</a></li>
        </ul>
      </nav>

      <nav aria-label="Policies">
        <p class="ds-footer__heading">Policies</p>
        <ul role="list">
          {%- if shop.shipping_policy != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Shipping Policy</a></li>{%- endif -%}
          {%- if shop.refund_policy != blank -%}<li><a href="{{ shop.refund_policy.url }}">Refund Policy</a></li>{%- endif -%}
          {%- if shop.privacy_policy != blank -%}<li><a href="{{ shop.privacy_policy.url }}">Privacy Policy</a></li>{%- endif -%}
          {%- if shop.terms_of_service != blank -%}<li><a href="{{ shop.terms_of_service.url }}">Terms of Service</a></li>{%- endif -%}
        </ul>
      </nav>

      <div>
        <p class="ds-footer__heading">Support</p>
        <ul role="list">
          {%- if section.settings.contact_page != blank -%}
            <li><a href="{{ section.settings.contact_page }}">Contact Us</a></li>
          {%- endif -%}
          {%- assign email = section.settings.email | default: shop.email -%}
          {%- if email != blank -%}
            <li><a href="mailto:{{ email }}">{{ email }}</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    <div class="ds-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="ds-footer__payments" role="list" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "DrySense: Footer",
  "tag": "div",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "brand", "label": "Wordmark", "default": "DRYSENSE" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Fresh shoes. Every day." },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Thoughtfully designed footwear-care technology for everyday life."
    },
    { "type": "product", "id": "classic_product", "label": "Classic product" },
    { "type": "product", "id": "pro_product", "label": "Pro product" },
    { "type": "url", "id": "contact_page", "label": "Contact page", "default": "/pages/contact" },
    { "type": "text", "id": "email", "label": "Support email", "info": "Defaults to your store's sender email" },
    { "type": "header", "content": "Social" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    {
      "type": "paragraph",
      "content": "Payment icons are shown automatically for the methods enabled in Settings → Payments. Policy links appear once each policy is filled in under Settings → Policies."
    }
  ],
  "presets": [{ "name": "DrySense: Footer" }]
}
{% endschema %}
