{%- comment -%}
  Real-customer media carousel (videos and photos). Swipe on mobile, arrows on
  desktop. Videos autoplay muted only while on screen (drysense.js).
{%- endcomment -%}
<section class="ds ds-ugc" aria-labelledby="DsUgcHeading-{{ section.id }}">
  <div class="ds__container">
    <header class="ds-head ds-head--center">
      <h2 id="DsUgcHeading-{{ section.id }}" class="ds-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="ds-lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </header>

    <div class="ds-ugc__wrap">
      <button type="button" class="ds-ugc__arrow ds-ugc__arrow--prev" data-ds-ugc-prev aria-label="Previous">
        <svg class="ds-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"/><path d="m11 18-6-6 6-6"/></svg>
      </button>

      <ul class="ds-ugc__track" role="list" data-ds-ugc-track>
        {%- for block in section.blocks -%}
          <li class="ds-ugc__item" {{ block.shopify_attributes }}>
            <div class="ds-ugc__media">
              {%- if block.settings.video != blank -%}
                {{
                  block.settings.video
                  | video_tag:
                    autoplay: false,
                    loop: true,
                    muted: true,
                    playsinline: true,
                    controls: false,
                    preload: 'none',
                    image_size: '600x'
                }}
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 750px) 300px, 70vw', loading: 'lazy'
                }}
              {%- else -%}
                <div class="ds-media__placeholder" role="img" aria-label="Customer video placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="15" height="14" rx="2"/><path d="m17 10 5-3v10l-5-3"/></svg>
                  <span class="ds-media__label">Customer video {{ forloop.index }}</span>
                </div>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <span class="ds-ugc__caption">{{ block.settings.caption | escape }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.name != blank -%}
              <p class="ds-ugc__name">{{ block.settings.name | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      <button type="button" class="ds-ugc__arrow ds-ugc__arrow--next" data-ds-ugc-next aria-label="Next">
        <svg class="ds-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DrySense: Customer videos",
  "tag": "div",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "media",
      "name": "Video or photo",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Vertical 9:16 clips work best" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Used when no video is set" },
        { "type": "text", "id": "caption", "label": "Caption", "info": "Short overlay, e.g. \"Easy setup\"" },
        { "type": "text", "id": "name", "label": "Customer name", "info": "Only real customers, with their permission" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Customers. Real Results." },
    { "type": "text", "id": "text", "label": "Text", "default": "See DrySense at home with people like you." }
  ],
  "presets": [
    {
      "name": "DrySense: Customer videos",
      "blocks": [{ "type": "media" }, { "type": "media" }, { "type": "media" }, { "type": "media" }]
    }
  ]
}
{% endschema %}
