<section class="ds ds--warm" aria-labelledby="DsGuaranteeHeading-{{ section.id }}">
  <div class="ds__container">
    <div class="ds-guarantee">
      <span class="ds-guarantee__seal">{% render 'ds-icon', name: 'shield' %}</span>
      <div>
        <h2 id="DsGuaranteeHeading-{{ section.id }}" class="ds-h2">{{ section.settings.heading | escape }}</h2>
        <p class="ds-lead">
          {{ section.settings.text | escape }}
          {%- if shop.refund_policy != blank %}
            <a class="ds-link" href="{{ shop.refund_policy.url }}">Read our refund policy</a>
          {%- endif -%}
        </p>
        <ul class="ds-guarantee__points" role="list">
          <li>{% render 'ds-icon', name: 'check' %}{{ section.settings.point_1 | escape }}</li>
          <li>{% render 'ds-icon', name: 'lock' %}{{ section.settings.point_2 | escape }}</li>
          <li>{% render 'ds-icon', name: 'headset' %}{{ section.settings.point_3 | escape }}</li>
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DrySense: Guarantee",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try DrySense Risk-Free for 30 Days." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We want you to feel confident about your purchase. If DrySense doesn't meet your expectations, contact our support team within 30 days of receiving your order and request a refund, subject to our published return policy.",
      "info": "Must match the refund policy in Settings → Policies."
    },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "30-day money-back guarantee" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "Secure checkout" },
    { "type": "text", "id": "point_3", "label": "Point 3", "default": "Customer support" }
  ],
  "presets": [{ "name": "DrySense: Guarantee" }]
}
{% endschema %}
