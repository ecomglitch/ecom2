<section
  id="how-it-works"
  class="ds ds--alt ds-anchor"
  aria-labelledby="DsStepsHeading-{{ section.id }}"
>
  <div class="ds__container">
    <header class="ds-head" data-ds-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="DsStepsHeading-{{ section.id }}" class="ds-h2">{{ section.settings.heading | escape }}</h2>
    </header>

    <ol class="ds-steps" role="list">
      {%- for block in section.blocks -%}
        <li class="ds-step" data-ds-reveal style="--ds-delay: {{ forloop.index0 | times: 120 }}ms;" {{ block.shopify_attributes }}>
          <span class="ds-step__marker">{% render 'ds-icon', name: block.settings.icon %}</span>
          <span class="ds-step__label">Step {{ forloop.index }}</span>
          <h3 class="ds-h3">{{ block.settings.title | escape }}</h3>
          <p class="ds-body">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "DrySense: How it works",
  "tag": "div",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sliders", "label": "Sliders" },
            { "value": "timer", "label": "Timer" },
            { "value": "wind", "label": "Airflow" }
          ],
          "default": "sliders"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three Simple Steps. A Fresher Start." }
  ],
  "presets": [{ "name": "DrySense: How it works" }]
}
{% endschema %}
